public record UserEntityName
{
    public string Value { get; }

    public UserEntityName(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            throw new UserInvalidException();
        }

        Value = value;
    }

    public static implicit operator string(UserEntityName name)
        => name.Value;

    public static implicit operator UserEntityName(string name)
        => new(name);
}